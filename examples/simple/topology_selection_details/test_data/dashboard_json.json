        "PROJECT_ID": {
            "default": null,
            "contextId": "projectid"
        },
        "INCIDENT_ID": {
            "default": "",
            "contextId": "incident_id"
        },
        "A_INCIDENT_ID": {
            "default": "",
            "contextId": "a_incident_id"
        },
        "STACK_NAME": {
            "default": "",
            "contextId": "attrs_stack_name"
        },
        "SELECTED_NODE_ID": {
            "contextId": "selected_node_id"
        },
        "MY_TEMPLATE": {
            "default": "<details><summary><b>{{row.a_alert_type}}</b></summary><div class='v-data-table v-data-table--dense theme--light'><div class='v-data-table__wrapper'><table style='width: 300px;'><tbody><tr><td>Source</td><td>{{row.a_source_systemname}}</td></tr><tr><td>Message</td><td>{{row.a_message}}</td></tr><tr><td>Assett IP</td><td>{{row.a_asset_ip_address}}</td></tr><tr><td>Alert Status</td><td>{{row.a_status}}</td></tr></tbody></table></div></div></details>",
            "contextId": "MY_TEMPLATE"
        },
        "NODE_TYPE": {
            "default": null,
            "contextId": "nodeType"
        },
        "NODE_LABEL": {
            "contextId": "nodeLabel"
        },
        "htmlLabel": {
            "contextId": "htmlLabel"
        },
        "iconURL": {
            "contextId": "iconURL"
        },
        "NODE_LAYER": {
            "contextId": "nodeLayer"
        }
    },
    "computedContext": {
        "selected_node_id": {
            "expr": "navigatorWidgetContext and navigatorWidgetContext[0].node_id"
        },
        "nodeType": {
            "expr": "navigatorWidgetContext and navigatorWidgetContext[0].type"
        },
        "nodeLabel": {
            "expr": "navigatorWidgetContext and navigatorWidgetContext[0].label"
        },
        "htmlLabel": {
            "expr": "navigatorWidgetContext and navigatorWidgetContext[0].htmlLabel"
        },
        "iconURL": {
            "expr": "navigatorWidgetContext and navigatorWidgetContext[0].iconURL"
        },
        "nodeLayer": {
            "expr": "navigatorWidgetContext and navigatorWidgetContext[0].layer"
        }
    },
    "dashboard_filters": {
        "time_filter": true,
        "default_time_range": {
            "from_time": "{{INCIDENT_CREATED_TIME}}",
            "from_time_delta_hours": -0.5,
            "to_time": "{{INCIDENT_CREATED_TIME}}",
            "to_time_delta_hours": 0.5,
            "label": "Time Range"
        },
        "columns_filter": []
    },
