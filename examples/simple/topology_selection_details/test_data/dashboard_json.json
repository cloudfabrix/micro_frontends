{
    "name": "incident-details-topology",
    "label": "Dynamic Incident Topology",
    "description": "Dynamic Incident Topology",
    "dashboard_style": "auto",
    "dashboard_type": "template",
    "version": "26.2.3.1",
    "enabled": false,
    "exportable": false,
    "live_edit": true,
    "dashboard_generator": {
        "attachment": "generator_jinja"
