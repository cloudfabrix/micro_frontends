<body>
    <div class="container" id="relations-view">
        <div class="graph-container" id="graph-container"></div>
    </div>
    <script>
        const layoutMode = {{ layout_mode | tojson }};
        const focalNodeId = {{ focal_node_id | tojson }};
        const navigatorEdges = {{ navigator_edges | tojson }};
        const configError = {{ config_error | tojson }};
        const topologyData = {{ topology_data_json | safe }};
        const allVariables = {{ all_variables_json | safe }};
        const node_list_raw = {{ node_list_raw | tojson }};

        const defaultAttributeMap = {
            nodeLabel: ['node_label', 'hostname', 'node_id'],
            nodeIcon: 'node_type',
            edgeCenterLabel: 'link_type',
            edgeSourceLabel: 'local_port',
            edgeDestLabel: 'remote_port',
            edgeColor: 'edge_color',
            edgeSourceLabelColor: 'source_label_outline_color',
            edgeDestLabelColor: 'dest_label_outline_color'
        };
        const attributeMap = Object.assign(
            {},
            defaultAttributeMap,
            {{ attribute_map_override_json | safe }}
        );

        const iconMap = window.parent?.cfxIconMap || {};

        /** Align navigator displayAttributes values with graph left_id/right_id */
        function normId(id) {
            if (id == null || id === '') {
                return '';
            }
            return String(id).trim();
        }

        function relTouchesNode(r, nodeId) {
            const n = normId(nodeId);
            return normId(r.left_id) === n || normId(r.right_id) === n;
        }

        function peerOnRel(r, focusId) {
            const f = normId(focusId);
            if (normId(r.left_id) === f) {
                return normId(r.right_id);
            }
            if (normId(r.right_id) === f) {
                return normId(r.left_id);
            }
            return '';
        }

        function getAttributeMapValue(relationship, attributeMapKey) {
            const keyOrKeys = attributeMap[attributeMapKey];
            if (!keyOrKeys) {
                return '';
            }
            const keys = Array.isArray(keyOrKeys) ? keyOrKeys : [keyOrKeys];
            const displayAttrs = relationship.displayAttributes;
            for (let ki = 0; ki < keys.length; ki++) {
                const key = keys[ki];
                const value = _.get(relationship, key);
                if (value !== undefined && value !== null && value !== '') {
                    return String(value);
                }
                if (displayAttrs && Array.isArray(displayAttrs)) {
                    const displayAttr = displayAttrs.find(function (attr) {
                        return attr.key === key;
                    });
                    if (
                        displayAttr &&
                        displayAttr.value !== undefined &&
                        displayAttr.value !== null &&
                        displayAttr.value !== ''
                    ) {
                        return String(displayAttr.value);
                    }
                }
            }
            return '';
        }

        function resolveIconSrc(node, map, amap) {
            const nodeIconKeys = Array.isArray(amap.nodeIcon) ? amap.nodeIcon : [amap.nodeIcon];
            let nodeIcon = '';
            for (let i = 0; i < nodeIconKeys.length; i++) {
                const candidate = _.get(node, nodeIconKeys[i], '');
                if (candidate && candidate !== 'Not Available') {
                    nodeIcon = candidate;
                    break;
                }
            }
            if (!nodeIcon) {
                const defaultCandidate = _.get(node, defaultAttributeMap.nodeIcon, '');
                if (defaultCandidate && defaultCandidate !== 'Not Available') {
                    nodeIcon = defaultCandidate;
                }
            }
            //console.log('resolveIconSrc: node', node);
            //console.log('resolveIconSrc: nodeIconKeys', nodeIconKeys);
            //console.log('resolveIconSrc: nodeIcon', nodeIcon);
            //console.log('resolveIconSrc: map', map);
            //console.log('resolveIconSrc: amap', amap);
            if (nodeIcon && (nodeIcon.startsWith('http://') || nodeIcon.startsWith('https://'))) {
                return nodeIcon;
            }
            if (nodeIcon && map[nodeIcon]) {
                return '/' + map[nodeIcon];
            }
            return '/assets/img/blueprints/canvas/empty_icon.png';
        }

        function createNodeEl(node, idSuffix, amap) {
            const div = document.createElement('div');
            div.className = 'node';
            const safeId = String(idSuffix).replace(/[^a-zA-Z0-9_-]/g, '_');
            div.id = 'node-' + safeId;
            const label = getAttributeMapValue(node, 'nodeLabel');
            const iconSrc = resolveIconSrc(node, iconMap, amap);
            div.innerHTML =
                '<div class="node-circle"><img src="" alt="" /></div><div class="node-label"></div>';
            div.querySelector('img').src = iconSrc;
            div.querySelector('.node-label').textContent = label;
            return div;
        }

        function buildPseudoFocal(focusId, rels) {
            const f = normId(focusId);
            const r = rels.find(function (x) {
                return normId(x.left_id) === f;
            });
            if (r) {
                return {
                    node_id: f,
                    node_label: r.left_label,
                    hostname: r.left_label,
                    node_type: r.left_node_type,
                    iconURL: 'Not Available'
                };
            }
            const r2 = rels.find(function (x) {
                return normId(x.right_id) === f;
            });
            if (!r2) {
                return {
                    node_id: f,
                    node_label: f,
                    hostname: f,
                    node_type: '',
                    iconURL: 'Not Available'
                };
            }
            return {
                node_id: f,
                node_label: r2.right_label,
                hostname: r2.right_label,
                node_type: r2.right_node_type,
                iconURL: 'Not Available'
            };
        }

        function pseudoNodeForPeer(peerId, rels) {
            const p = normId(peerId);
            const r = rels[0];
            if (normId(r.left_id) === p) {
                return {
                    node_id: p,
                    node_label: r.left_label,
                    hostname: r.left_label,
                    node_type: r.left_node_type,
                    iconURL: 'Not Available'
                };
            }
            return {
                node_id: p,
                node_label: r.right_label,
                hostname: r.right_label,
                node_type: r.right_node_type,
                iconURL: 'Not Available'
            };
        }

        function createEdgesInto(edgesContainer, relationships, focusId, amap) {
            relationships.forEach(function (relationship) {
                const edgeDiv = document.createElement('div');
                edgeDiv.className = 'edge';
                if (relationship.dotted) {
                    edgeDiv.classList.add('dotted');
                }

                const edgeColor = getAttributeMapValue(relationship, 'edgeColor') || '#666';
                const edgeLine = document.createElement('div');
                edgeLine.className = 'edge-line';

                if (relationship.dotted) {
                    edgeLine.style.background =
                        'repeating-linear-gradient(to right, ' +
                        edgeColor +
                        ' 0px, ' +
                        edgeColor +
                        ' 8px, transparent 8px, transparent 16px)';
                } else {
                    edgeLine.style.backgroundColor = edgeColor;
                }

                const focusNorm = normId(focusId);
                const isRightToLeft =
                    normId(relationship.left_id) !== focusNorm &&
                    normId(relationship.right_id) === focusNorm;
                const isDirectionless = relationship.direction === 'NO_DIRECTION';

                const arrow = document.createElement('div');
                arrow.className = 'arrow ' + (isRightToLeft ? 'left' : 'right');
                if (isRightToLeft) {
                    arrow.style.borderRightColor = edgeColor;
                } else {
                    arrow.style.borderLeftColor = edgeColor;
                }

                const edgeLabel = document.createElement('div');
                edgeLabel.className = 'edge-label';
                let centerText = getAttributeMapValue(relationship, 'edgeCenterLabel');
                if (!centerText) {
                    centerText = relationship.relation_type || '';
                }
                edgeLabel.textContent = centerText;

                let sourceInterfaceValue;
                let destInterfaceValue;
                if (focusNorm === normId(relationship.left_id)) {
                    sourceInterfaceValue = getAttributeMapValue(relationship, 'edgeSourceLabel');
                    destInterfaceValue = getAttributeMapValue(relationship, 'edgeDestLabel');
                } else {
                    sourceInterfaceValue = getAttributeMapValue(relationship, 'edgeDestLabel');
                    destInterfaceValue = getAttributeMapValue(relationship, 'edgeSourceLabel');
                }

                const sourceLabelColor =
                    getAttributeMapValue(relationship, 'edgeSourceLabelColor') || '#1976d2';
                const destLabelColor =
                    getAttributeMapValue(relationship, 'edgeDestLabelColor') || '#1976d2';

                let sourceInterfaceLabel;
                if (sourceInterfaceValue) {
                    sourceInterfaceLabel = document.createElement('p');
                    sourceInterfaceLabel.title = sourceInterfaceValue;
                    sourceInterfaceLabel.className =
                        'interface-label ' + (isRightToLeft ? 'right' : 'left');
                    sourceInterfaceLabel.textContent = sourceInterfaceValue;
                    sourceInterfaceLabel.style.color = sourceLabelColor;
                }

                let destInterfaceLabel;
                if (destInterfaceValue) {
                    destInterfaceLabel = document.createElement('p');
                    destInterfaceLabel.title = destInterfaceValue;
                    destInterfaceLabel.className =
                        'interface-label ' + (isRightToLeft ? 'left' : 'right');
                    destInterfaceLabel.textContent = destInterfaceValue;
                    destInterfaceLabel.style.color = destLabelColor;
                }

                if (!isDirectionless) {
                    edgeLine.appendChild(arrow);
                }
                edgeDiv.appendChild(edgeLine);
                edgeDiv.appendChild(edgeLabel);
                if (sourceInterfaceLabel) {
                    edgeDiv.appendChild(sourceInterfaceLabel);
                }
                if (destInterfaceLabel) {
                    edgeDiv.appendChild(destInterfaceLabel);
                }
                edgesContainer.appendChild(edgeDiv);
            });
        }

        function buildEdgeDetailsStrip(rels, visualLeftId) {
            const edgesWrap = document.createElement('div');
            edgesWrap.className = 'edges-container';
            const leftLine = document.createElement('div');
            leftLine.className = 'parallel-line';
            const edgesInner = document.createElement('div');
            edgesInner.className = 'edges';
            const rightLine = document.createElement('div');
            rightLine.className = 'parallel-line';
            if (rels.length) {
                createEdgesInto(edgesInner, rels, visualLeftId, attributeMap);
            }
            edgesWrap.appendChild(leftLine);
            edgesWrap.appendChild(edgesInner);
            edgesWrap.appendChild(rightLine);
            return edgesWrap;
        }

        function isGroupId(s) {
            return typeof s === 'string' && s.indexOf('groupNode') === 0;
        }

        function getDisplayAttrValue(edgeObj, key) {
            const attrs = edgeObj.displayAttributes || [];
            for (let i = 0; i < attrs.length; i++) {
                const a = attrs[i];
                if (a.key === key && a.value !== undefined && a.value !== null && a.value !== '') {
                    return String(a.value);
                }
            }
            return '';
        }

        /**
         * Flatten a navigator edge into a relationship-shaped object so the existing
         * createEdgesInto / getAttributeMapValue helpers (which read top-level fields with
         * displayAttributes fallback) work unchanged.
         */
        function buildRelFromNavigatorEdge(edgeObj) {
            const targetArrow = edgeObj.targetArrowShape;
            const sourceArrow = edgeObj.sourceArrowShape;
            const hasArrow =
                (targetArrow && targetArrow !== 'none') || (sourceArrow && sourceArrow !== 'none');
            return {
                left_id: getDisplayAttrValue(edgeObj, 'left_id'),
                right_id: getDisplayAttrValue(edgeObj, 'right_id'),
                left_label: getDisplayAttrValue(edgeObj, 'left_label'),
                right_label: getDisplayAttrValue(edgeObj, 'right_label'),
                relation_type: getDisplayAttrValue(edgeObj, 'relation_type'),
                link_type: getDisplayAttrValue(edgeObj, 'link_type'),
                local_port: getDisplayAttrValue(edgeObj, 'local_port'),
                remote_port: getDisplayAttrValue(edgeObj, 'remote_port'),
                edge_color: edgeObj.lineColor || '',
                direction: hasArrow ? 'OUT' : 'NO_DIRECTION',
                dotted: edgeObj.lineStyle === 'dashed' || edgeObj.dotted === true,
                displayAttributes: edgeObj.displayAttributes || []
            };
        }

        function parseNavigatorEdge(edgeObj) {
            const leftId = normId(getDisplayAttrValue(edgeObj, 'left_id'));
            const rightId = normId(getDisplayAttrValue(edgeObj, 'right_id'));
            const leftIsGroup = isGroupId(edgeObj.source);
            const rightIsGroup = isGroupId(edgeObj.target);
            return {
                leftId: leftId,
                rightId: rightId,
                leftIsGroup: leftIsGroup,
                rightIsGroup: rightIsGroup,
                leftGroupId: leftIsGroup ? String(edgeObj.source) : '',
                rightGroupId: rightIsGroup ? String(edgeObj.target) : '',
                rel: buildRelFromNavigatorEdge(edgeObj)
            };
        }

        function parseAllNavigatorEdges() {
            const edges = [];
            const groupIds = new Set();
            let leftGroupId = '';
            let rightGroupId = '';
            for (let i = 0; i < navigatorEdges.length; i++) {
                const parsed = parseNavigatorEdge(navigatorEdges[i]);
                if (!parsed.leftId || !parsed.rightId) {
                    continue;
                }
                edges.push(parsed);
                if (parsed.leftGroupId) {
                    groupIds.add(parsed.leftGroupId);
                    if (!leftGroupId) {
                        leftGroupId = parsed.leftGroupId;
                    }
                }
                if (parsed.rightGroupId) {
                    groupIds.add(parsed.rightGroupId);
                    if (!rightGroupId) {
                        rightGroupId = parsed.rightGroupId;
                    }
                }
            }
            return {
                edges: edges,
                groupIds: groupIds,
                leftGroupId: leftGroupId,
                rightGroupId: rightGroupId
            };
        }

        function pseudoNodeFromRel(realId, rel, side) {
            const label =
                side === 'left'
                    ? rel && rel.left_label
                    : rel && rel.right_label;
            return {
                node_id: realId,
                node_label: label || realId,
                hostname: label || realId,
                node_type: '',
                iconURL: 'Not Available'
            };
        }

        function resolveNavigatorNode(realId, parsedEdge, side, nodeMap) {
            const fromMap = nodeMap.get(realId);
            if (fromMap) {
                return fromMap;
            }
            return pseudoNodeFromRel(realId, parsedEdge.rel, side);
        }

        function initHub(graphContainer, nodes, relationships, nodeMap, focusId, allowedPeersSet) {
            const focusNorm = normId(focusId);
            let filtered = relationships.filter(function (r) {
                return relTouchesNode(r, focusNorm);
            });
            if (allowedPeersSet && allowedPeersSet.size > 0) {
                const allowedNorm = new Set(
                    Array.from(allowedPeersSet).map(function (x) {
                        return normId(x);
                    })
                );
                const narrowed = filtered.filter(function (r) {
                    const peer = peerOnRel(r, focusNorm);
                    return peer && allowedNorm.has(peer);
                });
                if (narrowed.length > 0) {
                    filtered = narrowed;
                }
                /* If navigator peer ids do not match graph ids, still show hub edges */
            }

            if (!filtered.length) {
                const msg = document.createElement('div');
                msg.className = 'empty-message';
                msg.textContent = 'No relationships to display.';
                graphContainer.appendChild(msg);
                return;
            }

            let focalNode = nodeMap.get(focusNorm) || nodeMap.get(focusId);
            if (!focalNode) {
                focalNode = buildPseudoFocal(focusNorm, filtered);
            }

            const hubLayout = document.createElement('div');
            hubLayout.className = 'hub-layout';

            const focalCol = document.createElement('div');
            focalCol.className = 'hub-focal';
            focalCol.appendChild(createNodeEl(focalNode, 'focal', attributeMap));

            const hubConnections = document.createElement('div');
            hubConnections.className = 'hub-connections';

            const leftParallel = document.createElement('div');
            leftParallel.className = 'parallel-line hub-parallel-left';

            const rowsCol = document.createElement('div');
            rowsCol.className = 'hub-rows';

            const byPeer = new Map();
            for (let i = 0; i < filtered.length; i++) {
                const r = filtered[i];
                const peer = peerOnRel(r, focusNorm);
                if (!peer) {
                    continue;
                }
                if (!byPeer.has(peer)) {
                    byPeer.set(peer, []);
                }
                byPeer.get(peer).push(r);
            }

            const sortedPeers = Array.from(byPeer.keys()).sort(function (a, b) {
                return String(a).localeCompare(String(b));
            });

            for (let i = 0; i < sortedPeers.length; i++) {
                const peerId = sortedPeers[i];
                const rels = byPeer.get(peerId);
                const row = document.createElement('div');
                row.className = 'hub-peer-row';

                const edgesWrap = document.createElement('div');
                edgesWrap.className = 'edges-container';
                const edgesInner = document.createElement('div');
                edgesInner.className = 'edges';
                const rightLine = document.createElement('div');
                rightLine.className = 'parallel-line';
                createEdgesInto(edgesInner, rels, focusNorm, attributeMap);
                edgesWrap.appendChild(edgesInner);
                edgesWrap.appendChild(rightLine);

                const peerNode = nodeMap.get(peerId) || pseudoNodeForPeer(peerId, rels);
                const peerEl = createNodeEl(peerNode, peerId, attributeMap);

                row.appendChild(edgesWrap);
                row.appendChild(peerEl);
                rowsCol.appendChild(row);
            }

            hubConnections.appendChild(leftParallel);
            hubConnections.appendChild(rowsCol);

            const scrollInner = document.createElement('div');
            scrollInner.className = 'hub-graph-inner';
            scrollInner.appendChild(hubConnections);

            hubLayout.appendChild(focalCol);
            hubLayout.appendChild(scrollInner);
            graphContainer.appendChild(hubLayout);
        }

        /** Case C: no groupNode endpoints — one row per unique (left,right) pair. */
        function renderPerEdgeRows(graphContainer, parsedEdges, nodeMap) {
            const stack = document.createElement('div');
            stack.className = 'edge-rows-stack';

            const byPair = new Map();
            const orderedKeys = [];
            for (let i = 0; i < parsedEdges.length; i++) {
                const pe = parsedEdges[i];
                const a = pe.leftId;
                const b = pe.rightId;
                const key = a < b ? a + '|' + b : b + '|' + a;
                if (!byPair.has(key)) {
                    byPair.set(key, { leftId: a, rightId: b, edges: [] });
                    orderedKeys.push(key);
                }
                byPair.get(key).edges.push(pe);
            }

            for (let i = 0; i < orderedKeys.length; i++) {
                const group = byPair.get(orderedKeys[i]);
                const rels = group.edges.map(function (pe) { return pe.rel; });
                const leftNode = resolveNavigatorNode(group.leftId, group.edges[0], 'left', nodeMap);
                const rightNode = resolveNavigatorNode(group.rightId, group.edges[0], 'right', nodeMap);

                const row = document.createElement('div');
                row.className = 'edge-details-row';
                row.appendChild(createNodeEl(leftNode, group.leftId, attributeMap));
                row.appendChild(buildEdgeDetailsStrip(rels, group.leftId));
                row.appendChild(createNodeEl(rightNode, group.rightId, attributeMap));

                stack.appendChild(row);
            }

            const scrollInner = document.createElement('div');
            scrollInner.className = 'hub-graph-inner';
            scrollInner.appendChild(stack);
            graphContainer.appendChild(scrollInner);
        }

        /**
         * Case A: exactly one groupNode side — single (non-group) node renders on the
         * visual left as the focal; unique group members stack as peers on the right.
         */
        function renderSingleGroupHub(graphContainer, parsed, nodeMap) {
            const groupOnLeft = parsed.leftGroupId !== '';

            let singleNodeId = '';
            const memberOrder = [];
            const memberSeen = new Set();
            const edgesByMember = new Map();
            let firstParsedEdge = null;

            for (let i = 0; i < parsed.edges.length; i++) {
                const pe = parsed.edges[i];
                const memberId = groupOnLeft ? pe.leftId : pe.rightId;
                const singleId = groupOnLeft ? pe.rightId : pe.leftId;
                if (!singleNodeId) {
                    singleNodeId = singleId;
                    firstParsedEdge = pe;
                } else if (singleNodeId !== singleId) {
                    console.warn(
                        'topology_relations_view: navigator edges have inconsistent non-group endpoint; using "' +
                            singleNodeId +
                            '".'
                    );
                }
                if (!memberSeen.has(memberId)) {
                    memberSeen.add(memberId);
                    memberOrder.push(memberId);
                    edgesByMember.set(memberId, []);
                }
                edgesByMember.get(memberId).push(pe);
            }

            if (!singleNodeId) {
                const msg = document.createElement('div');
                msg.className = 'empty-message';
                msg.textContent = 'No valid non-group endpoint in navigatorWidgetContext.';
                graphContainer.appendChild(msg);
                return;
            }

            const focalSide = groupOnLeft ? 'right' : 'left';
            const memberSide = groupOnLeft ? 'left' : 'right';
            const focalNode = resolveNavigatorNode(singleNodeId, firstParsedEdge, focalSide, nodeMap);

            const hubLayout = document.createElement('div');
            hubLayout.className = 'hub-layout';

            const focalCol = document.createElement('div');
            focalCol.className = 'hub-focal';
            focalCol.appendChild(createNodeEl(focalNode, 'focal', attributeMap));

            const hubConnections = document.createElement('div');
            hubConnections.className = 'hub-connections';

            const leftParallel = document.createElement('div');
            leftParallel.className = 'parallel-line hub-parallel-left';

            const rowsCol = document.createElement('div');
            rowsCol.className = 'hub-rows';

            for (let i = 0; i < memberOrder.length; i++) {
                const memberId = memberOrder[i];
                const memberEdges = edgesByMember.get(memberId);
                const rels = memberEdges.map(function (pe) { return pe.rel; });

                const row = document.createElement('div');
                row.className = 'hub-peer-row';

                const edgesWrap = document.createElement('div');
                edgesWrap.className = 'edges-container';
                const edgesInner = document.createElement('div');
                edgesInner.className = 'edges';
                const rightLine = document.createElement('div');
                rightLine.className = 'parallel-line';
                createEdgesInto(edgesInner, rels, singleNodeId, attributeMap);
                edgesWrap.appendChild(edgesInner);
                edgesWrap.appendChild(rightLine);

                const memberNode = resolveNavigatorNode(memberId, memberEdges[0], memberSide, nodeMap);
                const memberEl = createNodeEl(memberNode, memberId, attributeMap);

                row.appendChild(edgesWrap);
                row.appendChild(memberEl);
                rowsCol.appendChild(row);
            }

            hubConnections.appendChild(leftParallel);
            hubConnections.appendChild(rowsCol);

            const scrollInner = document.createElement('div');
            scrollInner.className = 'hub-graph-inner';
            scrollInner.appendChild(hubConnections);

            hubLayout.appendChild(focalCol);
            hubLayout.appendChild(scrollInner);
            graphContainer.appendChild(hubLayout);
        }

        /**
         * Case B: both sides grouped — render one mini-hub per unique left-group
         * member. Right-group members repeat across mini-hubs only when they have
         * more than one left peer (no crossings, no unnecessary duplication).
         */
        function renderTwoGroupBipartite(graphContainer, parsed, nodeMap) {
            const leftOrder = [];
            const leftSeen = new Set();
            const slotByLeft = new Map();

            for (let i = 0; i < parsed.edges.length; i++) {
                const pe = parsed.edges[i];
                if (!leftSeen.has(pe.leftId)) {
                    leftSeen.add(pe.leftId);
                    leftOrder.push(pe.leftId);
                    slotByLeft.set(pe.leftId, {
                        sample: pe,
                        peerOrder: [],
                        peerSeen: new Set(),
                        byPeer: new Map()
                    });
                }
                const slot = slotByLeft.get(pe.leftId);
                if (!slot.peerSeen.has(pe.rightId)) {
                    slot.peerSeen.add(pe.rightId);
                    slot.peerOrder.push(pe.rightId);
                    slot.byPeer.set(pe.rightId, []);
                }
                slot.byPeer.get(pe.rightId).push(pe);
            }

            const stack = document.createElement('div');
            stack.className = 'edge-rows-stack';

            for (let i = 0; i < leftOrder.length; i++) {
                const leftId = leftOrder[i];
                const slot = slotByLeft.get(leftId);

                const hubLayout = document.createElement('div');
                hubLayout.className = 'hub-layout';

                const focalCol = document.createElement('div');
                focalCol.className = 'hub-focal';
                const leftNode = resolveNavigatorNode(leftId, slot.sample, 'left', nodeMap);
                focalCol.appendChild(createNodeEl(leftNode, 'left-' + i, attributeMap));

                const hubConnections = document.createElement('div');
                hubConnections.className = 'hub-connections';

                const leftParallel = document.createElement('div');
                leftParallel.className = 'parallel-line hub-parallel-left';

                const rowsCol = document.createElement('div');
                rowsCol.className = 'hub-rows';

                for (let j = 0; j < slot.peerOrder.length; j++) {
                    const peerId = slot.peerOrder[j];
                    const peerEdges = slot.byPeer.get(peerId);
                    const rels = peerEdges.map(function (pe) { return pe.rel; });

                    const row = document.createElement('div');
                    row.className = 'hub-peer-row';

                    const edgesWrap = document.createElement('div');
                    edgesWrap.className = 'edges-container';
                    const edgesInner = document.createElement('div');
                    edgesInner.className = 'edges';
                    const rightLine = document.createElement('div');
                    rightLine.className = 'parallel-line';
                    createEdgesInto(edgesInner, rels, leftId, attributeMap);
                    edgesWrap.appendChild(edgesInner);
                    edgesWrap.appendChild(rightLine);

                    const peerNode = resolveNavigatorNode(peerId, peerEdges[0], 'right', nodeMap);
                    const peerEl = createNodeEl(peerNode, 'right-' + i + '-' + j, attributeMap);

                    row.appendChild(edgesWrap);
                    row.appendChild(peerEl);
                    rowsCol.appendChild(row);
                }

                hubConnections.appendChild(leftParallel);
                hubConnections.appendChild(rowsCol);
                hubLayout.appendChild(focalCol);
                hubLayout.appendChild(hubConnections);
                stack.appendChild(hubLayout);
            }

            const scrollInner = document.createElement('div');
            scrollInner.className = 'hub-graph-inner';
            scrollInner.appendChild(stack);
            graphContainer.appendChild(scrollInner);
        }

        function initEdgeRows(graphContainer, nodeMap) {
            const parsed = parseAllNavigatorEdges();

            if (!parsed.edges.length) {
                const msg = document.createElement('div');
                msg.className = 'empty-message';
                msg.textContent = 'No valid edges in navigatorWidgetContext.';
                graphContainer.appendChild(msg);
                return;
            }

            const groupCount = parsed.groupIds.size;
            if (groupCount === 0) {
                renderPerEdgeRows(graphContainer, parsed.edges, nodeMap);
            } else if (groupCount === 1) {
                renderSingleGroupHub(graphContainer, parsed, nodeMap);
            } else {
                renderTwoGroupBipartite(graphContainer, parsed, nodeMap);
            }
        }

        function initGraph() {
            const graphContainer = document.getElementById('graph-container');
            graphContainer.innerHTML = '';

            if (configError) {
                const msg = document.createElement('div');
                msg.className = 'empty-message';
                msg.textContent = configError;
                graphContainer.appendChild(msg);
                return;
            }

            const nodes = topologyData?.stack?.nodes || [];
            const relationships = topologyData?.stack?.relationships || [];
            const nodeMap = new Map(nodes.map(function (n) { return [n.node_id, n]; }));

            if (layoutMode === 'hub') {
                if (!focalNodeId) {
                    const msg = document.createElement('div');
                    msg.className = 'empty-message';
                    msg.textContent = 'No focal node (context.node_id) for hub layout.';
                    graphContainer.appendChild(msg);
                    return;
                }
                initHub(graphContainer, nodes, relationships, nodeMap, focalNodeId, null);
            } else if (layoutMode === 'edgeRows') {
                if (!navigatorEdges.length) {
                    const msg = document.createElement('div');
                    msg.className = 'empty-message';
                    msg.textContent = 'No edges in context.navigatorWidgetContext.';
                    graphContainer.appendChild(msg);
                    return;
                }
                initEdgeRows(graphContainer, nodeMap);
            } else {
                const msg = document.createElement('div');
                msg.className = 'empty-message';
                msg.textContent = 'Unknown layout mode.';
                graphContainer.appendChild(msg);
                return;
            }

            console.log('topology_relations_view widget: topologyData', topologyData);
            console.log('topology_relations_view widget: allVariables', allVariables);
            console.log('topology_relations_view widget: node_list_raw', node_list_raw);
        }

        initGraph();

        // Run this inside the iframe
        const parentStyles = getComputedStyle(parent.document.documentElement);
        const themeColor = parentStyles.getPropertyValue('--v-theme-cfxcard').trim();
        const textColor = parentStyles.getPropertyValue('--v-theme-cfxtext').trim();

        // Apply it to the iframe's root
        document.documentElement.style.setProperty('--v-theme-cfxcard', themeColor);
        document.documentElement.style.setProperty('--v-theme-cfxtext', textColor);
    </script>
</body>
</html>
