{# Jinja code start #}
{#
get_topology_data usage (given by Purvi):
get_topology_data(stack_name=None, node_list=None, query=None, relation_map=None, graph_name=None, db_name=None, nodes_collection=None, edges_collection=None).
#}

{#
  ── Widget usage scenarios ──────────────────────────────────────────────────

  Scenario 1 — Single focal node  (layout_mode = 'hub')
    context.node_id is set (usually coming from stack navigator with node list item selected).
    Renders that node on the left as the focal point; every peer it is
    connected to (from the fetched topology graph) fans out as rows on the
    right.

  Scenario 2 — Navigator edges  (layout_mode = 'edgeRows')
    context.node_id is absent; context.navigatorWidgetContext carries one or
    more edge objects (user clicked an edge or a grouped edge in the topology navigator widget).
    Only those navigator widget edges are rendered — the topology fetch is used
    solely to enrich node labels/icons.  Layout is determined by how many
    distinct groupNode endpoints appear:
      • 0 groupNodes → one left–right strip per unique node pair.
      • 1 groupNode  → single non-group node on the left (focal); each group
                        member as a peer row on the right.
      • 2 groupNodes → stack of mini-hubs, one per left-group member, with
                        right-group peers repeating only when needed to avoid
                        edge crossings.

  ────────────────────────────────────────────────────────────────────────────
#}

{% set context = all_variables.context %}
{% set fv = all_variables.fixed_variables | default({}) %}

{% set stack_name = fv.stack_name | default('', true) %}
{% if not stack_name %}
    {% set stack_name = context.attrs_stack_name | default('', true) %}
{% endif %}

{% set config_error = none %}
{% if not stack_name %}
    {% set config_error = 'Stack name is required. Set fixed_variables.stack_name or context.attrs_stack_name.' %}
{% endif %}

{% set nodes_collection = fv.nodes_collection | default(none) %}
{% set edges_collection = fv.edges_collection | default(none) %}
{% set graph_name = fv.graph_name | default(none) %}
{% set relation_map = fv.relation_map | default(none) %}

{% set navigator_edges = context.navigatorWidgetContext | default([]) %}

{% set node_list_raw = [] %}
{% set layout_mode = 'hub' %}
{% set focal_node_id = none %}

{% if not config_error %}
    {% if context.node_id is defined and context.node_id %}
        {% set node_list_raw = [context.node_id] %}
        {% set layout_mode = 'hub' %}
        {% set focal_node_id = context.node_id %}
    {% else %}
        {% set ns_ids = namespace(ids=[]) %}
        {% for edge in navigator_edges %}
            {% for attr in edge.displayAttributes | default([]) %}
                {% if attr.key in ['left_id', 'right_id'] and attr.value %}
                    {% set _ = ns_ids.ids.append(attr.value) %}
                {% endif %}
            {% endfor %}
        {% endfor %}
        {% set node_list_raw = ns_ids.ids | unique | list %}
        {% set layout_mode = 'edgeRows' %}
    {% endif %}
{% endif %}

{% if not config_error and (node_list_raw | length) == 0 %}
    {% set config_error = 'No nodes to display. Provide context.node_id or context.navigatorWidgetContext with left_id/right_id in displayAttributes.' %}
{% endif %}

{% set topology_data = {} %}
{% if not config_error %}
    {% set topology_data = engine.get_topology_data(
        stack_name=stack_name,
        node_list=node_list_raw,
        nodes_collection=nodes_collection,
        edges_collection=edges_collection,
        graph_name=graph_name,
        relation_map=relation_map
    ) %}

    {# If the response includes chunk_info, keep fetching until has_more_results is false. #}
    {% if topology_data.chunk_info is defined %}
        {% set ns = namespace(
            nodes=topology_data.stack.nodes | list,
            relationships=topology_data.stack.relationships | list,
            chunk_info=topology_data.chunk_info,
            done=not topology_data.chunk_info.has_more_results
        ) %}

        {% for _ in range(20) %}
            {% if not ns.done %}
                {% set next_chunk = engine.get_topology_data(
                    stack_name=stack_name,
                    node_list=node_list_raw,
                    nodes_collection=nodes_collection,
                    edges_collection=edges_collection,
                    graph_name=graph_name,
                    relation_map=relation_map,
                    chunk_offset=ns.chunk_info.next_chunk_offset
                ) %}
                {% for n in next_chunk.stack.nodes %}
                    {% set _ = ns.nodes.append(n) %}
                {% endfor %}
                {% for r in next_chunk.stack.relationships %}
                    {% set _ = ns.relationships.append(r) %}
                {% endfor %}
                {% set ns.chunk_info = next_chunk.chunk_info %}
                {% if not ns.chunk_info.has_more_results %}
                    {% set ns.done = true %}
                {% endif %}
            {% endif %}
        {% endfor %}

        {# Rebuild topology_data with the fully merged stack. #}
        {% set topology_data = {
            'chunk_info': ns.chunk_info,
            'stack': {
                'name':          topology_data.stack.name,
                'description':   topology_data.stack.description,
                'hierarchical':  topology_data.stack.hierarchical,
                'nodes':         ns.nodes,
                'relationships': ns.relationships
            }
        } %}
    {% endif %}
{% endif %}

{% set topology_data_json = topology_data | tojson %}
{% set all_variables_json = all_variables | tojson %}
{% set attribute_map_override_json = fv.attributeMap | default({}) | tojson %}

{# Jinja code end #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relations View</title>
    <script src="https://cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.min.js"></script>
    <style>
        /*
         * Embedded in an iframe inside a widget. Only `body` scrolls — `html` is fixed
         * to the iframe height so the root element does not get its own scrollbar.
         */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            height: 100%;
            width: 100%;
            overflow: hidden;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: rgb(var(--v-theme-cfxcard));
            color: rgb(var(--v-theme-cfxtext));
            height: 100%;
            width: 100%;
            margin: 0;
            overflow-x: hidden;
            overflow-y: auto;
            overscroll-behavior: contain;
            -webkit-overflow-scrolling: touch;
        }

        .container {
            width: 100%;
            max-width: 100%;
            min-height: 100%;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            box-sizing: border-box;
        }

        .graph-container {
            width: 100%;
            max-width: 100%;
            height: auto;
            display: flex;
            align-items: stretch;
            justify-content: flex-start;
            padding: 20px;
            box-sizing: border-box;
            overflow-x: visible;
            overflow-y: visible;
        }

        /* Connections column only — hub-focal stays outside so it is not an overflow ancestor. */
        .hub-graph-inner {
            flex: 1;
            min-width: 0;
            max-width: 100%;
            overflow-x: auto;
            overscroll-behavior-x: contain;
        }

        .hub-layout {
            display: flex;
            flex-direction: row;
            align-items: stretch;
            width: 100%;
            min-height: 180px;
            flex: 1;
        }

        .hub-focal {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            padding-right: 16px;
            align-self: flex-start;
        }

        .hub-connections {
            display: flex;
            flex-direction: row;
            align-items: stretch;
            flex: 1;
            min-width: 0;
        }

        .hub-parallel-left {
            flex-shrink: 0;
            margin-right: 10px;
        }

        .hub-rows {
            flex: 1;
            display: flex;
