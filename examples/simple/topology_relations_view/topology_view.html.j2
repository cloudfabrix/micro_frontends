{# Jinja + Vue 3 + Vue Flow — topology cards, smoothstep edges, distinct handles, dashed/directed like main. #}
{#
get_topology_data usage (given by Purvi):
get_topology_data(stack_name=None, node_list=None, query=None, relation_map=None, graph_name=None, db_name=None, nodes_collection=None, edges_collection=None).
#}

{% set context = all_variables.context %}
{% set fv = all_variables.fixed_variables | default({}) %}

{% set stack_name = fv.stack_name | default('', true) %}
{% if not stack_name %}
    {% set stack_name = context.attrs_stack_name | default('', true) %}
{% endif %}

{% set config_error = none %}
{% if not stack_name %}
    {% set config_error = 'Stack name is required. Set fixed_variables.stack_name or context.attrs_stack_name.' %}
{% endif %}

{% set nodes_collection = fv.nodes_collection | default(none) %}
{% set edges_collection = fv.edges_collection | default(none) %}
{% set graph_name = fv.graph_name | default(none) %}
{% set relation_map = fv.relation_map | default(none) %}

{% set navigator_edges = context.navigatorWidgetContext | default([]) %}

{% set node_list_raw = [] %}
{% set layout_mode = 'hub' %}
{% set focal_node_id = none %}

{% if not config_error %}
    {% if context.node_id is defined and context.node_id %}
        {% set node_list_raw = [context.node_id] %}
        {% set layout_mode = 'hub' %}
        {% set focal_node_id = context.node_id %}
    {% else %}
        {% set ns_ids = namespace(ids=[]) %}
        {% for edge in navigator_edges %}
            {% for attr in edge.displayAttributes | default([]) %}
                {% if attr.key in ['left_id', 'right_id'] and attr.value %}
                    {% set _ = ns_ids.ids.append(attr.value) %}
                {% endif %}
            {% endfor %}
        {% endfor %}
        {% set node_list_raw = ns_ids.ids | unique | list %}
        {% set layout_mode = 'edgeRows' %}
    {% endif %}
{% endif %}

{% if not config_error and (node_list_raw | length) == 0 %}
    {% set config_error = 'No nodes to display. Provide context.node_id or context.navigatorWidgetContext with left_id/right_id in displayAttributes.' %}
{% endif %}

{% set topology_data = {} %}
{% if not config_error %}
    {% set topology_data = engine.get_topology_data(
        stack_name=stack_name,
        node_list=node_list_raw,
        nodes_collection=nodes_collection,
        edges_collection=edges_collection,
        graph_name=graph_name,
        relation_map=relation_map
    ) %}
{% endif %}

{% set topology_data_json = topology_data | tojson %}
{% set all_variables_json = all_variables | tojson %}
{% set attribute_map_override_json = fv.attributeMap | default({}) | tojson %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Topology — graph view</title>
    <script src="https://cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@vue-flow/core@1.41.2/dist/style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@vue-flow/controls@1.1.2/dist/style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@vue-flow/background@1.3.0/dist/style.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            height: 100%;
            width: 100%;
            overflow: hidden;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
            height: 100%;
            width: 100%;
            margin: 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            overscroll-behavior: contain;
        }

        #config-error-banner {
            display: none;
            flex-shrink: 0;
            padding: 12px 16px;
            background: #fff3cd;
            color: #856404;
            border-bottom: 1px solid #ffc107;
            font-size: 14px;
        }

        #config-error-banner.visible {
            display: block;
        }

        #graph-wrap {
            flex: 1;
            min-height: 0;
            width: 100%;
            padding: 12px;
            display: flex;
            flex-direction: column;
        }

        #topology-graph {
            flex: 1;
            min-height: 400px;
            width: 100%;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        #topology-graph .vue-flow {
            width: 100%;
            height: 100%;
            min-height: 400px;
        }

        #empty-graph {
            display: none;
            padding: 24px;
            text-align: center;
            color: #333;
            font-size: 14px;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        #empty-graph.visible {
            display: block;
        }

        .vf-topology-card {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            min-width: 128px;
            max-width: 160px;
            padding: 10px 12px 12px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06), 0 4px 12px rgba(15, 23, 42, 0.06);
        }

        .vf-topology-card.vf-topology-card--selected {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

        .vf-topology-card__img {
            width: 48px;
            height: 48px;
            object-fit: contain;
            border-radius: 8px;
            background: #f1f5f9;
        }

        .vf-topology-card__label {
            margin-top: 8px;
            font-size: 11px;
            font-weight: 600;
            color: #0f172a;
            text-align: center;
            line-height: 1.25;
            word-break: break-word;
        }

        .vf-handle-t {
            z-index: 3;
            border: 1px solid #cbd5e1 !important;
            background: #fff !important;
            width: 9px !important;
            height: 9px !important;
            min-width: 9px !important;
            min-height: 9px !important;
        }

        .vf-handle-s {
            z-index: 3;
            border: 1px solid #94a3b8 !important;
            background: #f8fafc !important;
            width: 9px !important;
            height: 9px !important;
            min-width: 9px !important;
            min-height: 9px !important;
        }

        .vf-port-lbl {
            z-index: 2;
            font-size: 10px;
            font-weight: 600;
            line-height: 1.2;
            max-width: 118px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            pointer-events: none;
            user-select: none;
        }
    </style>
</head>
<body>
    <div id="config-error-banner" role="alert"></div>
    <div id="graph-wrap">
        <div id="empty-graph">No relationships to display in this topology response.</div>
        <div id="topology-graph"></div>
    </div>
    <script>
        const configError = {{ config_error | tojson }};
        const topologyData = {{ topology_data_json | safe }};
        const allVariables = {{ all_variables_json | safe }};
        const node_list_raw = {{ node_list_raw | tojson }};
        const layoutMode = {{ layout_mode | tojson }};
        const focalNodeId = {{ focal_node_id | tojson }};

        const defaultAttributeMap = {
            nodeLabel: 'node_label',
            nodeIcon: 'node_type',
            edgeCenterLabel: 'link_type',
            edgeSourceLabel: 'local_port',
            edgeDestLabel: 'remote_port',
            edgeColor: 'edge_color',
            edgeSourceLabelColor: 'source_label_outline_color',
            edgeDestLabelColor: 'dest_label_outline_color'
        };
        const attributeMap = Object.assign(
            {},
            defaultAttributeMap,
            {{ attribute_map_override_json | safe }}
        );

        const iconMap = window.parent && window.parent.cfxIconMap ? window.parent.cfxIconMap : {};

        const VF_NODE_W = 132;
        const VF_NODE_H = 96;
        const PORT_GAP_PX = 26;
        const PORT_BAND_FRAC = 0.35;
        const PORT_MID_GAP_PX = 18;
        const CARD_BODY_MIN_H = 94;
        const LAYOUT_ROW_GAP = 28;
        const LAYOUT_COL_MIN = 268;

        console.log('topology_relations_view topology_view: topologyData', topologyData);
        console.log('topology_relations_view topology_view: allVariables', allVariables);
        console.log('topology_relations_view topology_view: node_list_raw', node_list_raw);

        function normId(id) {
            if (id == null || id === '') {
                return '';
            }
            return String(id).trim();
        }

        function getAttributeMapValue(relationship, attributeMapKey) {
            const key = attributeMap[attributeMapKey];
            if (!key) {
                return '';
            }
            let value = _.get(relationship, key);
            if (value !== undefined && value !== null && value !== '') {
                return String(value);
            }
            const displayAttrs = relationship.displayAttributes;
            if (displayAttrs && Array.isArray(displayAttrs)) {
                const displayAttr = displayAttrs.find(function (attr) {
                    return attr.key === key;
                });
                if (
                    displayAttr &&
                    displayAttr.value !== undefined &&
                    displayAttr.value !== null &&
                    displayAttr.value !== ''
                ) {
                    return String(displayAttr.value);
                }
            }
            return '';
        }

        function resolveIconSrc(node, map, amap) {
            const nodeType = _.get(node, amap.nodeIcon, '') || node.node_type;
            const iconURL = node && node.iconURL;
            if (iconURL && (iconURL.startsWith('http://') || iconURL.startsWith('https://'))) {
                return iconURL;
            }
            if (nodeType && map[nodeType]) {
                return '/' + map[nodeType];
            }
            return '/assets/img/blueprints/canvas/empty_icon.png';
        }

        function pseudoNodeFromEndpoint(nodeId, rels) {
            const p = normId(nodeId);
            const r = rels.find(function (x) {
                return normId(x.left_id) === p;
            });
            const r2 = rels.find(function (x) {
                return normId(x.right_id) === p;
            });
            const use = r || r2;
            if (!use) {
                return {
                    node_id: p,
                    node_label: p,
                    hostname: p,
                    node_type: '',
                    iconURL: 'Not Available'
                };
            }
            if (normId(use.left_id) === p) {
                return {
                    node_id: p,
                    node_label: use.left_label,
                    hostname: use.left_label,
                    node_type: use.left_node_type,
                    iconURL: 'Not Available'
                };
            }
            return {
                node_id: p,
                node_label: use.right_label,
                hostname: use.right_label,
                node_type: use.right_node_type,
                iconURL: 'Not Available'
            };
        }

        function takeNextIndex(counterMap, nodeId) {
            const k = String(nodeId);
            const cur = counterMap.has(k) ? counterMap.get(k) : 0;
            counterMap.set(k, cur + 1);
            return cur;
        }

        function sortHandleIds(ids) {
            const arr = [].slice.call(ids);
            return arr.sort(function (a, b) {
                const na = parseInt(String(a).replace(/^[ts]/, ''), 10);
                const nb = parseInt(String(b).replace(/^[ts]/, ''), 10);
                return (isNaN(na) ? 0 : na) - (isNaN(nb) ? 0 : nb);
            });
        }

        function uniqueSortedHandles(list) {
            return sortHandleIds(Array.from(new Set(list)));
        }

        function buildUndirectedAdj(nodeIds, rawEdges) {
            const adj = new Map();
            for (let i = 0; i < nodeIds.length; i++) {
                adj.set(nodeIds[i], []);
            }
            for (let e = 0; e < rawEdges.length; e++) {
                const edge = rawEdges[e];
                if (!adj.has(edge.source) || !adj.has(edge.target)) {
                    continue;
                }
                adj.get(edge.source).push(edge.target);
                adj.get(edge.target).push(edge.source);
            }
            return adj;
        }

        function minHeightForPortBand(portCount) {
            if (portCount <= 0) {
                return 0;
            }
            if (portCount === 1) {
                return 36;
            }
            return Math.ceil(((portCount - 1) * PORT_GAP_PX) / PORT_BAND_FRAC);
        }

        function computeTopologyNodeDimensions(tCount, sCount, outLbl, inLbl) {
            const hasT = tCount > 0;
            const hasS = sCount > 0;
            let bodyH = CARD_BODY_MIN_H;
            if (hasT && hasS) {
                bodyH = Math.max(
                    CARD_BODY_MIN_H,
                    minHeightForPortBand(tCount) + PORT_MID_GAP_PX + minHeightForPortBand(sCount)
                );
            } else if (hasT) {
                bodyH = Math.max(CARD_BODY_MIN_H, minHeightForPortBand(tCount));
            } else if (hasS) {
                bodyH = Math.max(CARD_BODY_MIN_H, minHeightForPortBand(sCount));
            }
            let extraW = 0;
            function scanLbl(obj) {
                if (!obj || typeof obj !== 'object') {
                    return;
                }
                Object.keys(obj).forEach(function (k) {
                    const s = String(obj[k] || '');
                    if (s) {
                        extraW = Math.max(extraW, Math.min(150, 10 + s.length * 7));
                    }
                });
            }
            scanLbl(outLbl);
            scanLbl(inLbl);
            const w = Math.round(Math.max(VF_NODE_W, 108 + extraW));
            return { width: w, height: Math.round(bodyH) };
        }

        function layoutLayeredPositions(nodeIds, rawEdges, focalId, sizeById) {
            const idList = nodeIds.slice();
            const idSet = new Set(idList);
            const layer = new Map();
            const focal = focalId != null && focalId !== '' ? normId(focalId) : '';

            function getNodeHeight(id) {
                if (sizeById && sizeById.get) {
                    const s = sizeById.get(id);
                    if (s && typeof s.h === 'number') {
                        return s.h;
                    }
                }
                return VF_NODE_H;
            }

            function getNodeWidth(id) {
                if (sizeById && sizeById.get) {
                    const s = sizeById.get(id);
                    if (s && typeof s.w === 'number') {
                        return s.w;
                    }
                }
                return VF_NODE_W;
            }

            let maxNodeW = VF_NODE_W;
            for (let wi = 0; wi < idList.length; wi++) {
                maxNodeW = Math.max(maxNodeW, getNodeWidth(idList[wi]));
            }
            const colStep = Math.max(LAYOUT_COL_MIN, maxNodeW + 96);

            if (focal && idSet.has(focal)) {
                const adj = buildUndirectedAdj(idList, rawEdges);
                const queue = [focal];
                layer.set(focal, 0);
                while (queue.length) {
                    const u = queue.shift();
                    const lu = layer.get(u);
                    const nbr = adj.get(u) || [];
                    for (let i = 0; i < nbr.length; i++) {
                        const v = nbr[i];
                        if (!layer.has(v)) {
                            layer.set(v, lu + 1);
                            queue.push(v);
                        }
                    }
                }
                let maxReach = 0;
                for (let i = 0; i < idList.length; i++) {
                    const id = idList[i];
                    if (layer.has(id)) {
                        maxReach = Math.max(maxReach, layer.get(id));
                    }
                }
                const orphanLayer = maxReach + 1;
                for (let i = 0; i < idList.length; i++) {
                    const id = idList[i];
                    if (!layer.has(id)) {
                        layer.set(id, orphanLayer);
                    }
                }
            } else {
                for (let i = 0; i < idList.length; i++) {
                    layer.set(idList[i], 0);
                }
                const cap = idList.length + rawEdges.length + 8;
                for (let iter = 0; iter < cap; iter++) {
                    let changed = false;
                    for (let e = 0; e < rawEdges.length; e++) {
                        const edge = rawEdges[e];
                        if (!idSet.has(edge.source) || !idSet.has(edge.target)) {
                            continue;
                        }
                        if (edge.source === edge.target) {
                            continue;
                        }
                        const lu = layer.get(edge.source) || 0;
                        const lv = layer.get(edge.target) || 0;
                        if (lu + 1 > lv) {
                            layer.set(edge.target, lu + 1);
                            changed = true;
                        }
                    }
                    if (!changed) {
                        break;
                    }
                }
            }

            const byLayer = new Map();
            let maxL = 0;
            for (let i = 0; i < idList.length; i++) {
                const id = idList[i];
                const L = layer.get(id) || 0;
                maxL = Math.max(maxL, L);
                if (!byLayer.has(L)) {
                    byLayer.set(L, []);
                }
                byLayer.get(L).push(id);
            }
            byLayer.forEach(function (col) {
                col.sort(function (a, b) {
                    return String(a).localeCompare(String(b));
                });
            });

            const pos = {};
            for (let L = 0; L <= maxL; L++) {
                const col = byLayer.get(L) || [];
                const colLen = col.length;
                if (colLen === 0) {
                    continue;
                }
                let stack = 0;
                for (let j = 0; j < colLen; j++) {
                    stack += getNodeHeight(col[j]);
                    if (j < colLen - 1) {
                        stack += LAYOUT_ROW_GAP;
                    }
                }
                let yTop = -stack / 2;
                for (let j = 0; j < colLen; j++) {
                    const nid = col[j];
                    const nh = getNodeHeight(nid);
                    pos[nid] = {
                        x: L * colStep,
                        y: yTop
                    };
                    yTop += nh + LAYOUT_ROW_GAP;
                }
            }

            let minX = Infinity;
            let minY = Infinity;
            for (let i = 0; i < idList.length; i++) {
                const p = pos[idList[i]];
                if (p) {
                    minX = Math.min(minX, p.x);
                    minY = Math.min(minY, p.y);
                }
            }
            if (!isFinite(minX)) {
                minX = 0;
            }
            if (!isFinite(minY)) {
                minY = 0;
            }
            const PAD = 56;
            for (let i = 0; i < idList.length; i++) {
                const id = idList[i];
                const p = pos[id];
                if (p) {
                    p.x = p.x - minX + PAD;
                    p.y = p.y - minY + PAD;
                }
            }
            return pos;
        }
        function buildVueFlowPayload(nodes, relationships, allowedNodeIds, focalNodeIdRaw) {
            const focalNorm =
                focalNodeIdRaw != null && focalNodeIdRaw !== ''
                    ? normId(focalNodeIdRaw)
                    : '';
            const allowed =
                allowedNodeIds instanceof Set
                    ? allowedNodeIds
                    : new Set(
                          (allowedNodeIds || []).map(function (x) {
                              return normId(x);
                          }).filter(Boolean)
                      );

            const nodeMap = new Map();
            for (let i = 0; i < nodes.length; i++) {
                const n = nodes[i];
                const nid = normId(n.node_id);
                if (nid && !nodeMap.has(nid)) {
                    nodeMap.set(nid, n);
                }
                //if (nid && allowed.has(nid) && !nodeMap.has(nid)) {
                //    nodeMap.set(nid, n);
                //}
            }

            const rels = relationships || [];
            //const rels = (relationships || []).filter(function (r) {
            //    const L = normId(r.left_id);
            //    const R = normId(r.right_id);
            //    return L && R && allowed.has(L) && allowed.has(R);
            //});

            allowed.forEach(function (eid) {
                if (!nodeMap.has(eid)) {
                    nodeMap.set(eid, pseudoNodeFromEndpoint(eid, rels));
                }
            });

            const orderedIds = [];
            nodeMap.forEach(function (_, id) {
                orderedIds.push(id);
            });
            orderedIds.sort(function (a, b) {
                return String(a).localeCompare(String(b));
            });

            const handlePlan = new Map();
            for (let hi = 0; hi < orderedIds.length; hi++) {
                handlePlan.set(orderedIds[hi], { sources: [], targets: [] });
            }

            const sourceSlotByNode = new Map();
            const targetSlotByNode = new Map();
            const srcPortLabels = new Map();
            const tgtPortLabels = new Map();
            const srcPortColors = new Map();
            const tgtPortColors = new Map();
            const rawEdges = [];

            function lblBagSet(m, nodeId, hid, text, colorM, color) {
                const k = String(nodeId);
                if (text) {
                    if (!m.has(k)) {
                        m.set(k, {});
                    }
                    m.get(k)[hid] = text;
                }
                if (color && colorM) {
                    if (!colorM.has(k)) {
                        colorM.set(k, {});
                    }
                    colorM.get(k)[hid] = color;
                }
            }

            for (let k = 0; k < rels.length; k++) {
                const rel = rels[k];
                const src = normId(rel.left_id);
                const tgt = normId(rel.right_id);
                if (!src || !tgt) {
                    continue;
                }
                const eid = String(rel._key || rel._id || 'rel-' + k + '-' + src + '-' + tgt);
                const lineColor = getAttributeMapValue(rel, 'edgeColor') || '#64748b';
                let centerText = getAttributeMapValue(rel, 'edgeCenterLabel');
                if (!centerText) {
                    centerText = rel.relation_type || rel.link_type || '';
                }
                const sourceLabel = getAttributeMapValue(rel, 'edgeSourceLabel');
                const targetLabel = getAttributeMapValue(rel, 'edgeDestLabel');
                const srcColor =
                    getAttributeMapValue(rel, 'edgeSourceLabelColor') || '#1976d2';
                const tgtColor =
                    getAttributeMapValue(rel, 'edgeDestLabelColor') || '#1976d2';
                const directionless = rel.direction === 'NO_DIRECTION';

                const sIdx = takeNextIndex(sourceSlotByNode, src);
                const tIdx = takeNextIndex(targetSlotByNode, tgt);
                const sourceHandle = 's' + sIdx;
                const targetHandle = 't' + tIdx;

                handlePlan.get(src).sources.push(sourceHandle);
                handlePlan.get(tgt).targets.push(targetHandle);

                lblBagSet(srcPortLabels, src, sourceHandle, sourceLabel, srcPortColors, srcColor);
                lblBagSet(tgtPortLabels, tgt, targetHandle, targetLabel, tgtPortColors, tgtColor);

                rawEdges.push({
                    id: eid,
                    source: src,
                    target: tgt,
                    sourceHandle: sourceHandle,
                    targetHandle: targetHandle,
                    lineColor: lineColor,
                    dotted: !!rel.dotted,
                    directed: !directionless,
                    labelLine: centerText ? String(centerText) : ''
                });
            }

            const vfNodes = [];
            for (let ni = 0; ni < orderedIds.length; ni++) {
                const id = orderedIds[ni];
                const node = nodeMap.get(id);
                const label =
                    _.get(node, attributeMap.nodeLabel, '') ||
                    node.hostname ||
                    node.node_id ||
                    id;
                const hp = handlePlan.get(id) || { sources: [], targets: [] };
                const sh = uniqueSortedHandles(hp.sources);
                const th = uniqueSortedHandles(hp.targets);
                const outLbl = Object.assign({}, srcPortLabels.get(id) || {});
                const inLbl = Object.assign({}, tgtPortLabels.get(id) || {});
                const outCol = Object.assign({}, srcPortColors.get(id) || {});
                const inCol = Object.assign({}, tgtPortColors.get(id) || {});
                const dims = computeTopologyNodeDimensions(sh.length, th.length, outLbl, inLbl);
                const isFocal = focalNorm !== '' && id === focalNorm;
                vfNodes.push({
                    id: id,
                    type: 'topology',
                    position: { x: 0, y: 0 },
                    width: dims.width,
                    height: dims.height,
                    data: {
                        label: label,
                        iconSrc: resolveIconSrc(node, iconMap, attributeMap),
                        sourceHandles: sh,
                        targetHandles: th,
                        sourcePortLabels: outLbl,
                        targetPortLabels: inLbl,
                        sourcePortColors: outCol,
                        targetPortColors: inCol,
                        portsOnRight: isFocal
                    }
                });
            }

            return { nodes: vfNodes, rawEdges: rawEdges, orderedIds: orderedIds, nodeCount: vfNodes.length };
        }

        function showConfigError(msg) {
            const el = document.getElementById('config-error-banner');
            el.textContent = msg;
            el.classList.add('visible');
            console.warn('topology_relations_view topology_view: configError', msg);
        }

        function unmountVueFlow() {
            if (window.__topologyVueApp) {
                try {
                    window.__topologyVueApp.unmount();
                } catch (e) {
                    console.warn('topology_relations_view topology_view: vue unmount', e);
                }
                window.__topologyVueApp = null;
            }
            window.__topologyVueFlowFit = null;
        }
        window.unmountVueFlow = unmountVueFlow;

        (function bootstrapPayload() {
            const container = document.getElementById('topology-graph');
            const emptyEl = document.getElementById('empty-graph');

            if (configError) {
                unmountVueFlow();
                showConfigError(configError);
                container.style.display = 'none';
                emptyEl.classList.remove('visible');
                window.__topologyVFInit = { skip: true };
                return;
            }

            if (topologyData && topologyData.chunk_info && topologyData.chunk_info.has_more_results) {
                console.warn(
                    'topology_relations_view topology_view: topology response is chunked (has_more_results). Some edges may be missing until the engine returns additional chunks or a larger chunk_size.'
                );
            }

            const stackNodes = (topologyData && topologyData.stack && topologyData.stack.nodes) || [];
            const relationships =
                (topologyData && topologyData.stack && topologyData.stack.relationships) || [];

            const allowedNodeSet = new Set(
                (node_list_raw || []).map(function (x) {
                    return normId(x);
                }).filter(Boolean)
            );

            const bundle = buildVueFlowPayload(
                stackNodes,
                relationships,
                allowedNodeSet,
                focalNodeId
            );

            if (allowedNodeSet.size === 0 || bundle.nodeCount === 0) {
                unmountVueFlow();
                container.style.display = 'none';
                emptyEl.textContent =
                    'No nodes to display. Check context.node_id / navigatorWidgetContext IDs in node_list_raw.';
                emptyEl.classList.add('visible');
                window.__topologyVFInit = { skip: true };
                return;
            }

            emptyEl.classList.remove('visible');
            container.style.display = 'block';

            const sizeById = new Map();
            for (let si = 0; si < bundle.nodes.length; si++) {
                const nn = bundle.nodes[si];
                sizeById.set(nn.id, { w: nn.width, h: nn.height });
            }

            const positions = layoutLayeredPositions(
                bundle.orderedIds,
                bundle.rawEdges,
                focalNodeId,
                sizeById
            );

            const placedNodes = bundle.nodes.map(function (n) {
                const p = positions[n.id] || { x: 0, y: 0 };
                return Object.assign({}, n, { position: { x: p.x, y: p.y } });
            });

            window.__topologyVFInit = {
                skip: false,
                nodes: placedNodes,
                rawEdges: bundle.rawEdges,
                orderedIds: bundle.orderedIds,
                nodeCount: bundle.nodeCount,
                focalMeta: { layoutMode: layoutMode, focalNodeId: focalNodeId }
            };

            if (focalNodeId) {
                console.log(
                    'topology_relations_view topology_view: layoutMode',
                    layoutMode,
                    'focalNodeId',
                    focalNodeId
                );
            }
        })();
    </script>
    <script type="module">
        import {
            createApp,
            defineComponent,
            h,
            ref,
            markRaw
        } from 'https://esm.sh/vue@3.4.38';
        import {
            VueFlow,
            Handle,
            Position,
            MarkerType
        } from 'https://esm.sh/@vue-flow/core@1.41.2?deps=vue@3.4.38';
        import { Background } from 'https://esm.sh/@vue-flow/background@1.3.0?deps=vue@3.4.38,@vue-flow/core@1.41.2';
        import { Controls } from 'https://esm.sh/@vue-flow/controls@1.1.2?deps=vue@3.4.38,@vue-flow/core@1.41.2';

        const cfg = window.__topologyVFInit;
        if (!cfg || cfg.skip) {
        } else {
            function bandPercentsForIds(ids, bandLo, bandHi) {
                const map = new Map();
                const n = ids.length;
                if (!n) {
                    return map;
                }
                for (let i = 0; i < n; i++) {
                    const pct =
                        n === 1
                            ? (bandLo + bandHi) / 2
                            : bandLo + ((bandHi - bandLo) * i) / (n - 1);
                    map.set(ids[i], pct);
                }
                return map;
            }

            const TopologyNode = defineComponent({
                name: 'TopologyNode',
                props: {
                    data: { type: Object, required: true },
                    selected: Boolean
                },
                setup(props) {
                    return function renderTopoNode() {
                        const parts = [];
                        const portsOnRight = props.data.portsOnRight === true;
                        const srcLblMap = props.data.sourcePortLabels || {};
                        const tgtLblMap = props.data.targetPortLabels || {};
                        const srcColMap = props.data.sourcePortColors || {};
                        const tgtColMap = props.data.targetPortColors || {};

                        parts.push(
                            h(
                                'div',
                                {
                                    class: [
                                        'vf-topology-card',
                                        props.selected ? 'vf-topology-card--selected' : ''
                                    ]
                                },
                                [
                                    h('img', {
                                        class: 'vf-topology-card__img',
                                        src: props.data.iconSrc,
                                        alt: '',
                                        draggable: false
                                    }),
                                    h(
                                        'div',
                                        { class: 'vf-topology-card__label' },
                                        props.data.label || ''
                                    )
                                ]
                            )
                        );

                        const targetList = props.data.targetHandles || [];
                        const sourceList = props.data.sourceHandles || [];
                        const hasT = targetList.length > 0;
                        const hasS = sourceList.length > 0;
                        let tLo = 12;
                        let tHi = 88;
                        let sLo = 12;
                        let sHi = 88;
                        if (hasT && hasS) {
                            tLo = 10;
                            tHi = 44;
                            sLo = 56;
                            sHi = 90;
                        }
                        const tPct = bandPercentsForIds(targetList, tLo, tHi);
                        const sPct = bandPercentsForIds(sourceList, sLo, sHi);

                        const posOut = portsOnRight ? Position.Right : Position.Left;
                        const handleTx = portsOnRight
                            ? 'translate(50%, -50%)'
                            : 'translate(-50%, -50%)';
                        const lblOffset = portsOnRight
                            ? { right: '22px', left: 'auto' }
                            : { left: '22px', right: 'auto' };

                        for (let i = 0; i < targetList.length; i++) {
                            const hid = targetList[i];
                            const txt = tgtLblMap[hid];
                            const col = tgtColMap[hid] || '#0d47a1';
                            if (txt) {
                                parts.push(
                                    h(
                                        'span',
                                        {
                                            key: 'tlbl-' + hid,
                                            class: 'vf-port-lbl',
                                            style: Object.assign(
                                                {
                                                    position: 'absolute',
                                                    top: tPct.get(hid) + '%',
                                                    transform: 'translateY(-50%)',
                                                    color: col
                                                },
                                                lblOffset
                                            ),
                                            title: txt
                                        },
                                        txt
                                    )
                                );
                            }
                            parts.push(
                                h(Handle, {
                                    key: hid,
                                    id: hid,
                                    type: 'target',
                                    position: posOut,
                                    class: 'vf-handle-t',
                                    style: Object.assign(
                                        {
                                            top: tPct.get(hid) + '%',
                                            transform: handleTx
                                        },
                                        portsOnRight ? { right: 0, left: 'auto' } : { left: 0, right: 'auto' }
                                    )
                                })
                            );
                        }
                        for (let i = 0; i < sourceList.length; i++) {
                            const hid = sourceList[i];
                            const txt = srcLblMap[hid];
                            const col = srcColMap[hid] || '#1565c0';
                            if (txt) {
                                parts.push(
                                    h(
                                        'span',
                                        {
                                            key: 'slbl-' + hid,
                                            class: 'vf-port-lbl',
                                            style: Object.assign(
                                                {
                                                    position: 'absolute',
                                                    top: sPct.get(hid) + '%',
                                                    transform: 'translateY(-50%)',
                                                    color: col
                                                },
                                                lblOffset
                                            ),
                                            title: txt
                                        },
                                        txt
                                    )
                                );
                            }
                            parts.push(
                                h(Handle, {
                                    key: hid,
                                    id: hid,
                                    type: 'source',
                                    position: posOut,
                                    class: 'vf-handle-s',
                                    style: Object.assign(
                                        {
                                            top: sPct.get(hid) + '%',
                                            transform: handleTx
                                        },
                                        portsOnRight ? { right: 0, left: 'auto' } : { left: 0, right: 'auto' }
                                    )
                                })
                            );
                        }

                        return h(
                            'div',
                            {
                                style: {
                                    position: 'relative',
                                    width: '100%',
                                    height: '100%'
                                }
                            },
                            parts
                        );
                    };
                }
            });

            const edgesFinal = cfg.rawEdges.map(function (e) {
                const lab = e.labelLine || '';
                return {
                    id: e.id,
                    source: e.source,
                    target: e.target,
                    sourceHandle: e.sourceHandle,
                    targetHandle: e.targetHandle,
                    type: 'bezier',
                    label: lab,
                    labelShowBg: !!lab,
                    labelStyle: {
                        fill: '#0f172a',
                        fontSize: 11,
                        fontWeight: 500
                    },
                    labelBgStyle: {
                        fill: '#ffffff',
                        fillOpacity: 0.96,
                        stroke: '#e2e8f0',
                        strokeWidth: 1
                    },
                    style: {
                        stroke: e.lineColor,
                        strokeWidth: 2,
                        strokeDasharray: e.dotted ? '6 4' : undefined
                    },
                    markerEnd: e.directed
                        ? {
                              type: MarkerType.ArrowClosed,
                              width: 12,
                              height: 12,
                              color: e.lineColor
                          }
                        : undefined
                };
            });

            const App = defineComponent({
                name: 'TopologyVueFlowApp',
                setup() {
                    const nodes = ref(cfg.nodes.map(function (n) {
                        return Object.assign({}, n);
                    }));
                    const edges = ref(edgesFinal);

                    function onInit(api) {
                        window.__topologyVueFlowFit = function () {
                            api.fitView({ padding: 0.18, maxZoom: 1.15 });
                        };
                    }

                    return function () {
                        return h(
                            'div',
                            { style: { width: '100%', height: '100%', minHeight: '400px' } },
                            [
                                h(
                                    VueFlow,
                                    {
                                        nodes: nodes.value,
                                        edges: edges.value,
                                        nodeTypes: { topology: markRaw(TopologyNode) },
                                        onInit: onInit,
                                        fitViewOnInit: true,
                                        minZoom: 0.15,
                                        maxZoom: 2,
                                        snapToGrid: false,
                                        elevateEdgesOnSelect: true,
                                        nodesDraggable: false,
                                        nodesConnectable: false,
                                        edgesUpdatable: false,
                                        elementsSelectable: true
                                    },
                                    {
                                        default: function () {
                                            return [
                                                h(Background, {
                                                    gap: 16,
                                                    size: 1,
                                                    patternColor: '#e2e8f0',
                                                    variant: 'dots'
                                                }),
                                                h(Controls, { position: 'bottom-right' })
                                            ];
                                        }
                                    }
                                )
                            ]
                        );
                    };
                }
            });

            if (typeof window.unmountVueFlow === 'function') {
                window.unmountVueFlow();
            }
            const app = createApp(App);
            window.__topologyVueApp = app;
            app.mount('#topology-graph');

            if (window.__topologyVFResize) {
                window.removeEventListener('resize', window.__topologyVFResize);
            }
            window.__topologyVFResize = function () {
                if (window.__topologyVueFlowFit) {
                    window.__topologyVueFlowFit();
                }
            };
            window.addEventListener('resize', window.__topologyVFResize);
        }
    </script>
</body>
</html>
